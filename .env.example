# Copy to .env and adjust as needed: `cp .env.example .env`
# Everything below targets the local Docker Compose stack (docker-compose.yml);
# values are throwaway local credentials, not real secrets.

# ─────────────────────────────── Oracle ─────────────────────────────── #
ORACLE_PASSWORD=oracle
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1

ORACLE_SCHEMA=source_table
ORACLE_SCHEMA_PASSWORD=source_table

ORACLE_APP_USER=system
ORACLE_APP_PASSWORD=oracle

# ──────────────────── Object store + Iceberg catalog ────────────────── #
MINIO_ROOT_USER=minioaccesskey
MINIO_ROOT_PASSWORD=miniosecretkey
MINIO_ENDPOINT=http://localhost:9000    # S3 endpoint (also honoured as S3_ENDPOINT)
AWS_REGION=us-east-1                     # also honoured as S3_REGION

ICEBERG_REST_URI=http://localhost:8181   # the bank's Lakekeeper URL in prod
ICEBERG_WAREHOUSE=s3://warehouse/

ICEBERG_CATALOG_DB_USER=iceberg
ICEBERG_CATALOG_DB_PASSWORD=iceberg
ICEBERG_CATALOG_DB_NAME=iceberg_catalog

# ───────────────────────── dbt (host-side) ─────────────────────────── #
TRINO_HOST=localhost
TRINO_PORT=8080

# ───────────────────── Spark - local_parsing ─────────────────────── #

SPARK_LOCAL_IP=127.0.0.1
PYSPARK_SUBMIT_ARGS=--driver-memory 4g pyspark-shell
# HISTORY job only -- DAILY is always local[2] and needs none of it.
SPARK_JDBC_NUM_PARTITIONS=16
